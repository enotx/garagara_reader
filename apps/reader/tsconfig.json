{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@garagara/core": ["../../packages/core/src/index.ts"],
      "@garagara/lang-en": ["../../packages/lang-en/src/index.ts"],
      "@garagara/storage": ["../../packages/storage/src/index.ts"],
      "@garagara/storage/browser": ["../../packages/storage/src/browser-adapter.ts"]
    }
  },
  "include": ["src"]
}
